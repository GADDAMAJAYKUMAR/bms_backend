generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BatteryChemistry {
  id             String @id @default(uuid())
  chemistryName  String @unique
  nominalVoltage Float
  maxVoltage     Float
  minVoltage     Float
  energyDensity  Int
  cycleLife      Int
  safetyLevel    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  configs ChemistryConfig[]

  createdById String?
  createdBy   User?   @relation("CreatedChemistries", fields: [createdById], references: [id])
}

model ChemistryConfig {
  id String @id @default(uuid())

  vehicleModel           String
  chargeCutoffVoltage    Float
  dischargeCutoffVoltage Float
  temperatureLimit       Float
  firmwareVersion        String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  chemistryId String
  chemistry   BatteryChemistry @relation(fields: [chemistryId], references: [id])

  // relations
  createdById String?
  createdBy   User?   @relation("CreatedConfigs", fields: [createdById], references: [id])
}

model User {
  id                String   @id @default(uuid())

  fullName          String
  email             String   @unique

  phoneNumber       String?  @unique

  password          String?

  profilePicture    String?

  role              Role @default(USER)

  authProvider      AuthProvider @default(LOCAL)
  providerId        String?

  isEmailVerified   Boolean @default(false)
  isActive          Boolean @default(true)

  acceptedTerms     Boolean    @default(false)

  refreshToken      String?

  loginAttempts     Int        @default(0)
  lockUntil         DateTime?

  resetToken        String?
  resetTokenExpiry  DateTime?

  createdChemistries BatteryChemistry[] @relation("CreatedChemistries")
  createdConfigs ChemistryConfig[] @relation("CreatedConfigs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  USER
}

enum AuthProvider {
  LOCAL
  GOOGLE
  MICROSOFT
}


model ThermalSafety{
  id               Int             @id @default(autoincrement())
  parameterName    String
  thresholdValue   Float
  actionName       String
  
  configs ThermalSafetyConfig[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ThermalSafetyConfig{
  id                 Int              @id @default(autoincrement())

  vehicleName        String
  customThreshold    Float
  coolingEnabled     Boolean @default(false)
  firmwareVersion    String?

  thermalSafetyId     Int
  thermalSafety ThermalSafety @relation(fields: [thermalSafetyId], references:[id])

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}